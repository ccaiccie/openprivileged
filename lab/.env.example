# Copy to lab/.env (git-ignored) and fill in. Lab-only values: never reuse real passwords.
# ISOs: Microsoft Evaluation Center, Windows Server 2022 (180-day evaluation). virtio-win ISO from Fedora project.
WIN_ISO=/path/to/windows-server-2022-eval.iso
VIRTIO_ISO=/path/to/virtio-win.iso
LAB_DIR=/var/lib/libvirt/images/vglab

# Used by lab/tests/*.py (read from the environment, never hard-coded)
VG_DOMAIN=vg.lab
VG_DC1=10.77.0.11
VG_DC2=10.77.0.12
VG_WS1=10.77.0.21
VG_MANAGER_USER=svc-vaultgate
VG_MANAGER_PASSWORD=change-me-lab-only
VG_TEST_USER=vgtest01
VG_LOCAL_ADMIN=vgadmin
VG_WS_ADMIN_USER=VG\Administrator
VG_WS_ADMIN_PASSWORD=change-me-lab-only
